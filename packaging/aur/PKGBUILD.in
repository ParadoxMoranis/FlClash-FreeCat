pkgname=flclash-freecat-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc='FlClash with optional FreeCat subscription support'
arch=('x86_64' 'aarch64')
url='https://github.com/@REPOSITORY@'
license=('GPL-3.0-only')
depends=('at-spi2-core' 'cairo' 'fontconfig' 'gdk-pixbuf2' 'glib2' 'glibc'
         'gtk3' 'libayatana-appindicator' 'libepoxy' 'libgcc' 'libstdc++'
         'libx11' 'pango' 'libsecret')
makedepends=('patchelf')
optdepends=('gnome-keyring: Secret Service storage for FreeCat accounts'
            'kwallet: alternative Secret Service storage for FreeCat accounts'
            'polkit: graphical authorization for TUN helper installation')
provides=('flclash=@VERSION@')
conflicts=('flclash' 'flclash-bin' 'flclash-freecat' 'flclash-git')
options=('!strip' '!debug')
install=flclash-freecat.install
source=('flclash.desktop' 'flclash-freecat.install')
source_x86_64=('https://github.com/@REPOSITORY@/releases/download/@TAG@/FlClash-@VERSION@-linux-amd64.tar.gz')
source_aarch64=('https://github.com/@REPOSITORY@/releases/download/@TAG@/FlClash-@VERSION@-linux-arm64.tar.gz')
noextract=('FlClash-@VERSION@-linux-amd64.tar.gz' 'FlClash-@VERSION@-linux-arm64.tar.gz')
sha256sums=('@DESKTOP_SHA256@' '@INSTALL_SHA256@')
sha256sums_x86_64=('@AMD64_SHA256@')
sha256sums_aarch64=('@ARM64_SHA256@')

package() {
  local release_arch
  case "${CARCH}" in
    x86_64) release_arch=amd64 ;;
    aarch64) release_arch=arm64 ;;
    *) return 1 ;;
  esac

  local bundle="${pkgdir}/usr/lib/flclash"
  install -d "${bundle}" "${pkgdir}/usr/bin"
  bsdtar -xf "${srcdir}/FlClash-${pkgver}-linux-${release_arch}.tar.gz" -C "${bundle}" --no-same-owner
  chmod 755 "${bundle}" "${bundle}/FlClash" "${bundle}/FlClashCore" "${bundle}/FlClashHelperService"

  # Plugin build paths are not valid on the installed system. Core and Helper stay byte-identical.
  local library
  while IFS= read -r -d '' library; do
    patchelf --set-rpath '$ORIGIN' "${library}"
  done < <(find "${bundle}/lib" -type f -name '*plugin.so' -print0)

  ln -s /usr/lib/flclash/FlClash "${pkgdir}/usr/bin/flclash"
  install -Dm644 "${srcdir}/flclash.desktop" "${pkgdir}/usr/share/applications/flclash.desktop"
  install -Dm644 "${bundle}/data/flutter_assets/assets/images/icon.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/flclash.png"
}
